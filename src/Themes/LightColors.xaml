<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FFF0F0F0" />
    <SolidColorBrush x:Key="WindowForegroundBrush" Color="#FF1A1A1A" />
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#FFADADAD" />
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#FFE5F3FF" />
    <SolidColorBrush x:Key="ControlPressedBrush" Color="#FFCCE4F7" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#FF808080" />
    <SolidColorBrush x:Key="MenuBackgroundBrush" Color="#FFF0F0F0" />
    <SolidColorBrush x:Key="MenuItemHighlightBrush" Color="#FFCCE4F7" />
    <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="#FFF0F0F0" />
    <SolidColorBrush x:Key="TabBackgroundBrush" Color="#FFF0F0F0" />
    <SolidColorBrush x:Key="TabSelectedBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="ListSelectionBrush" Color="#FF0078D7" />
    <SolidColorBrush x:Key="ListSelectionInactiveBrush" Color="#FFDEDEDE" />
    <SolidColorBrush x:Key="ListSelectionTextBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="DisabledForegroundBrush" Color="#FF6D6D6D" />
    <SolidColorBrush x:Key="DisabledControlBackgroundBrush" Color="#FFF5F5F5" />
    <SolidColorBrush x:Key="SeparatorBrush" Color="#FFD0D0D0" />

    <!-- Override system brushes used by default control templates -->
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#FF1A1A1A" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#FFF0F0F0" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#FF1A1A1A" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightBrushKey}" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightLightBrushKey}" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlDarkBrushKey}" Color="#FFADADAD" />
    <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#FF6D6D6D" />
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#FFF0F0F0" />
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBarBrushKey}" Color="#FFF0F0F0" />
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#FF1A1A1A" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#FF0078D7" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFFFF" />

</ResourceDictionary>
