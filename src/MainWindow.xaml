<Window x:Class="SeventhEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Icon="/icon.ico"
        Height="720"
        Width="980"
        MinHeight="560"
        MinWidth="800">
    <Window.Resources>
        <Style x:Key="ListItemTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                    <Setter Property="FontStyle" Value="Italic" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="UnitListItemTemplate">
            <TextBlock Text="{Binding ListLabel}" Style="{StaticResource ListItemTextStyle}" />
        </DataTemplate>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,8" />
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
    </Window.InputBindings>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Open..." Command="{Binding OpenCommand}" InputGestureText="Ctrl+O" />
                <MenuItem Header="_Save" Command="{Binding SaveCommand}" InputGestureText="Ctrl+S" />
                <MenuItem Header="Save _As..." Command="{Binding SaveAsCommand}" />
                <Separator />
                <MenuItem Header="E_xit" Command="{Binding ExitCommand}" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About 7thEditor" Command="{Binding AboutCommand}" />
            </MenuItem>
        </Menu>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock>
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="Open a stuff.dat file to begin editing." />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasFile}" Value="True">
                                    <Setter Property="Text" Value="Enabled entries are written to stuff.dat. Disabled entries keep legion.exe defaults." />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StatusBarItem>
        </StatusBar>

        <TabControl Margin="8">
            <!-- Units -->
            <TabItem Header="Units">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280" MinWidth="200" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ListBox Grid.Column="0"
                             ItemsSource="{Binding Units}"
                             SelectedItem="{Binding SelectedUnit}"
                             ItemTemplate="{StaticResource UnitListItemTemplate}"
                             IsEnabled="{Binding HasFile}" />

                    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" />

                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Padding="12,0,0,0"
                                  IsEnabled="{Binding HasFile}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,12">
                                <TextBlock DockPanel.Dock="Left"
                                           Text="{Binding SelectedUnit.DisplayName}"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Enable"
                                            Width="90"
                                            Margin="0,0,8,0"
                                            Command="{Binding EnableUnitCommand}" />
                                    <Button Content="Disable"
                                            Width="90"
                                            Command="{Binding DisableUnitCommand}" />
                                </StackPanel>
                            </DockPanel>

                            <Grid IsEnabled="{Binding SelectedUnit.CanEdit}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Type id" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SelectedUnit.TypeId, Mode=OneWay}" IsReadOnly="True" Margin="0,0,0,8" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Cost" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SelectedUnit.Cost, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Health" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SelectedUnit.Health, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Build time" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding SelectedUnit.BuildTime, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Armour" Style="{StaticResource FieldLabel}" />
                                <ComboBox Grid.Row="4" Grid.Column="1"
                                          ItemsSource="{Binding ArmourClasses}"
                                          DisplayMemberPath="Name"
                                          SelectedValuePath="Value"
                                          SelectedValue="{Binding SelectedUnit.Armour}"
                                          Margin="0,0,0,8" />

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Weapon" Style="{StaticResource FieldLabel}" />
                                <ComboBox Grid.Row="5" Grid.Column="1"
                                          ItemsSource="{Binding WeaponTypes}"
                                          DisplayMemberPath="Name"
                                          SelectedValuePath="Value"
                                          SelectedValue="{Binding SelectedUnit.Weapon}"
                                          Margin="0,0,0,8" />

                                <TextBlock Grid.Row="6" Grid.Column="0" Text="Weapon 2" Style="{StaticResource FieldLabel}" />
                                <ComboBox Grid.Row="6" Grid.Column="1"
                                          ItemsSource="{Binding WeaponTypes}"
                                          DisplayMemberPath="Name"
                                          SelectedValuePath="Value"
                                          SelectedValue="{Binding SelectedUnit.Weapon2}"
                                          Margin="0,0,0,8" />

                                <TextBlock Grid.Row="7" Grid.Column="0" Text="Speed" Style="{StaticResource FieldLabel}" />
                                <DockPanel Grid.Row="7" Grid.Column="1" Margin="0,0,0,8">
                                    <TextBlock DockPanel.Dock="Right"
                                               Text="{Binding SelectedUnit.SpeedPreview}"
                                               VerticalAlignment="Center"
                                               Margin="8,0,0,0"
                                               Foreground="Gray" />
                                    <TextBox Text="{Binding SelectedUnit.Speed, UpdateSourceTrigger=PropertyChanged}" />
                                </DockPanel>

                                <TextBlock Grid.Row="8" Grid.Column="0" Text="Turn" Style="{StaticResource FieldLabel}" />
                                <DockPanel Grid.Row="8" Grid.Column="1" Margin="0,0,0,8">
                                    <TextBlock DockPanel.Dock="Right" Text=" (−1 = N/A)" VerticalAlignment="Center" Foreground="Gray" />
                                    <TextBox Text="{Binding SelectedUnit.TurnSpeed, UpdateSourceTrigger=PropertyChanged}" />
                                </DockPanel>

                                <TextBlock Grid.Row="9" Grid.Column="0" Text="Reload" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Row="9" Grid.Column="1" Text="{Binding SelectedUnit.ReloadTime, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- Buildings -->
            <TabItem Header="Buildings">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280" MinWidth="200" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ListBox Grid.Column="0"
                             ItemsSource="{Binding Buildings}"
                             SelectedItem="{Binding SelectedBuilding}"
                             ItemTemplate="{StaticResource UnitListItemTemplate}"
                             IsEnabled="{Binding HasFile}" />

                    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" />

                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Padding="12,0,0,0"
                                  IsEnabled="{Binding HasFile}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,12">
                                <TextBlock DockPanel.Dock="Left"
                                           Text="{Binding SelectedBuilding.DisplayName}"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Enable"
                                            Width="90"
                                            Margin="0,0,8,0"
                                            Command="{Binding EnableBuildingCommand}" />
                                    <Button Content="Disable"
                                            Width="90"
                                            Command="{Binding DisableBuildingCommand}" />
                                </StackPanel>
                            </DockPanel>

                            <Grid IsEnabled="{Binding SelectedBuilding.CanEdit}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Type id" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SelectedBuilding.TypeId, Mode=OneWay}" IsReadOnly="True" Margin="0,0,0,8" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Cost" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SelectedBuilding.Cost, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Health" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SelectedBuilding.Health, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Build time" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding SelectedBuilding.BuildTime, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Armour" Style="{StaticResource FieldLabel}" />
                                <ComboBox Grid.Row="4" Grid.Column="1"
                                          ItemsSource="{Binding ArmourClasses}"
                                          DisplayMemberPath="Name"
                                          SelectedValuePath="Value"
                                          SelectedValue="{Binding SelectedBuilding.Armour}"
                                          Margin="0,0,0,8" />

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Weapon" Style="{StaticResource FieldLabel}" />
                                <ComboBox Grid.Row="5" Grid.Column="1"
                                          ItemsSource="{Binding WeaponTypes}"
                                          DisplayMemberPath="Name"
                                          SelectedValuePath="Value"
                                          SelectedValue="{Binding SelectedBuilding.Weapon}"
                                          Margin="0,0,0,8" />
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- Weapons -->
            <TabItem Header="Weapons">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280" MinWidth="200" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ListBox Grid.Column="0"
                             ItemsSource="{Binding Weapons}"
                             SelectedItem="{Binding SelectedWeapon}"
                             DisplayMemberPath="ListLabel"
                             IsEnabled="{Binding HasFile}" />

                    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" />

                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Padding="12,0,0,0"
                                  IsEnabled="{Binding HasFile}">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedWeapon.Name}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,12" />

                            <TextBlock Text="Damage values are shown as decimals (stored as 16.16 fixed-point)."
                                       Foreground="Gray"
                                       Margin="0,0,0,12"
                                       TextWrapping="Wrap" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="vs Body" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Row="0" Grid.Column="1"
                                         Text="{Binding SelectedWeapon.DamageVsBodyText, UpdateSourceTrigger=LostFocus}"
                                         Margin="0,0,0,8" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="vs Light" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Row="1" Grid.Column="1"
                                         Text="{Binding SelectedWeapon.DamageVsLightText, UpdateSourceTrigger=LostFocus}"
                                         Margin="0,0,0,8" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="vs Medium" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Row="2" Grid.Column="1"
                                         Text="{Binding SelectedWeapon.DamageVsMediumText, UpdateSourceTrigger=LostFocus}"
                                         Margin="0,0,0,8" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="vs Heavy" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Row="3" Grid.Column="1"
                                         Text="{Binding SelectedWeapon.DamageVsHeavyText, UpdateSourceTrigger=LostFocus}"
                                         Margin="0,0,0,8" />

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="vs Structure" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Row="4" Grid.Column="1"
                                         Text="{Binding SelectedWeapon.DamageVsStructureText, UpdateSourceTrigger=LostFocus}"
                                         Margin="0,0,0,8" />
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
